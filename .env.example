APP_NAME=JobCardOnline
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=ojc_mac
DB_USERNAME=root
DB_PASSWORD=

# Cache / Queue / Session
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Filesystem
FILESYSTEM_DISK=public

# Redis (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mail.nexorasoftware.co.za
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@nexorasoftware.co.za"
MAIL_FROM_NAME=""

# Inertia SSR (optional)
INERTIA_SSR_ENABLED=false

# cPanel API
CPANEL_HOST=master.intouchsoft.co.za
CPANEL_PORT=2083
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_DOMAIN=nexorasoftware.co.za
CPANEL_HOME_DIR=/home

# Customer releases default to false. Set true only on the central licensing server.
IS_LICENSING_INSTANCE=false
LICENSE_SERVER_URL=https://admin.jc.revamp.house/
LICENSE_VALIDATION_TIMEOUT=10
LICENSE_API_MAX_CLOCK_SKEW=300

# Shared secret for the public query API (POST /api/queries). External sites
# (e.g. the Revamp landing page) must send this as the X-Api-Key header.
QUERY_API_KEY=
# Secret for browser-facing hosted/embedded query forms (/query-form/* token generation).
# Optional: when empty, tokens fall back to QUERY_API_KEY, then APP_KEY, so Hosted URL
# still appears on the Queries list for normal (non-licensing) instances.
QUERY_PUBLIC_FORM_KEY=

# Revamp webhook — pushed when a contractor accepts/declines a dispatched quote.
# REVAMP_API_KEY must match JOBCARDONLINE_API_KEY on the Revamp install.
REVAMP_URL=
REVAMP_API_KEY=

# Firebase Cloud Messaging (Android push) — HTTP v1 API
# Download a service account JSON from Firebase Console → Project settings → Service accounts → Generate new private key
# Option A (recommended): path to that JSON file on the server
FCM_CREDENTIALS_PATH=
# Bundled in release packages as storage/app/revampjobcard-8f5fb37b5d39.json; license deploy sets the path per instance
DEPLOY_FCM_CREDENTIALS_FILENAME=revampjobcard-8f5fb37b5d39.json
# Option B: individual fields from the service account JSON
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_APP_BUNDLE_ID=com.jobcardonline.app
APNS_PRIVATE_KEY=
# true for Xcode/debug iOS builds (api.sandbox.push.apple.com); false for TestFlight/App Store
APNS_USE_SANDBOX=false

# QuickBooks Online (OAuth client ID/secret are configured per company in Administration → QuickBooks)
# Redirect URI in Intuit Developer must match: {APP_URL}/quickbooks/callback
QUICKBOOKS_USE_SANDBOX=true
QUICKBOOKS_MINOR_VERSION=75
QUICKBOOKS_USER_AGENT="JobCardOnline/1.0 Laravel QuickBooks Client"

# Theme Colors (for white-labeling)
# Format: HSL values (hue 0-360, saturation 0-100, lightness 0-100)
# Leave empty to use default JobCardOnline colors (blue/teal theme)

# Primary color (main action buttons, links, highlights) - Gold (#A29862)
THEME_PRIMARY_HUE=51
THEME_PRIMARY_SATURATION=26
THEME_PRIMARY_LIGHTNESS=51
THEME_PRIMARY_DARK_MODE_LIGHTNESS=60

# Secondary color (complementary actions, accents) - Darker Gold
THEME_SECONDARY_HUE=51
THEME_SECONDARY_SATURATION=26
THEME_SECONDARY_LIGHTNESS=45
THEME_SECONDARY_DARK_MODE_LIGHTNESS=55

# Accent color (hover states, subtle highlights) - Lighter Gold
THEME_ACCENT_HUE=51
THEME_ACCENT_SATURATION=26
THEME_ACCENT_LIGHTNESS=55
THEME_ACCENT_DARK_MODE_LIGHTNESS=65

# Chart colors (for data visualization)
THEME_CHART_1_HUE=51
THEME_CHART_1_SATURATION=26
THEME_CHART_1_LIGHTNESS=51

THEME_CHART_2_HUE=51
THEME_CHART_2_SATURATION=26
THEME_CHART_2_LIGHTNESS=45

THEME_CHART_3_HUE=51
THEME_CHART_3_SATURATION=26
THEME_CHART_3_LIGHTNESS=55

THEME_CHART_4_HUE=51
THEME_CHART_4_SATURATION=26
THEME_CHART_4_LIGHTNESS=50

THEME_CHART_5_HUE=51
THEME_CHART_5_SATURATION=26
THEME_CHART_5_LIGHTNESS=60

# Sidebar colors
THEME_SIDEBAR_PRIMARY_HUE=51
THEME_SIDEBAR_PRIMARY_SATURATION=26
THEME_SIDEBAR_PRIMARY_LIGHTNESS=51
THEME_SIDEBAR_PRIMARY_DARK_MODE_LIGHTNESS=60

THEME_SIDEBAR_ACCENT_HUE=51
THEME_SIDEBAR_ACCENT_SATURATION=26
THEME_SIDEBAR_ACCENT_LIGHTNESS=95

# Background colors (light mode white, dark mode black)
THEME_BACKGROUND_LIGHT_MODE_LIGHTNESS=100
THEME_BACKGROUND_DARK_MODE_LIGHTNESS=3

# Layout variables
THEME_LAYOUT_SIDEBAR_WIDTH=260px
THEME_LAYOUT_SIDEBAR_COLLAPSED_WIDTH=64px
THEME_LAYOUT_HEADER_HEIGHT=64px
THEME_LAYOUT_BORDER_RADIUS=0.5rem
THEME_LAYOUT_SPACING_UNIT=1rem